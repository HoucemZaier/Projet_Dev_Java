<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" style="-fx-padding:20; -fx-background-color:#f8fafc;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.UpdateExcursionController">

    <!-- ID caché pour la mise à jour -->
    <TextField fx:id="idField" visible="false"/>

    <Label text="Modifier Excursion">
        <font><Font size="22"/></font>
    </Label>

    <TextField fx:id="titreField" promptText="Titre"/>
    <TextField fx:id="destinationField" promptText="Destination"/>
    <DatePicker fx:id="dateDepartPicker" promptText="Date de départ"/>
    <DatePicker fx:id="dateRetourPicker" promptText="Date de retour"/>
    <TextField fx:id="prixField" promptText="Prix"/>
    <TextField fx:id="nbPlacesField" promptText="Nombre de places"/>
    <ComboBox fx:id="statutComboBox" promptText="Statut"/>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding:20 0 0 0;">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8;"/>
        <Button text="Mettre à jour" onAction="#handleUpdate"
                style="-fx-background-color:linear-gradient(to right,#f59e0b,#d97706);
                       -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold;"/>
    </HBox>

</VBox>
