<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="416.0" prefWidth="450.0" spacing="10" style="-fx-padding:20; -fx-background-color:#f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.UpdateExcursionController">

    <TextField fx:id="idField" visible="false" />
    <Label text="Modifier Excursion">
        <font><Font size="22" /></font>
    </Label>

    <TextField fx:id="titreField" promptText="Titre" />
    <TextField fx:id="destinationField" promptText="Destination" />
    <DatePicker fx:id="dateDepartPicker" promptText="Date de départ" />
    <DatePicker fx:id="dateRetourPicker" promptText="Date de retour" />
    <TextField fx:id="prixField" promptText="Prix" />
    <TextField fx:id="nbPlacesField" promptText="Nombre de places" />
    <ComboBox fx:id="statutComboBox" promptText="Statut" />

    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding:20 0 0 0;">
        <Button onAction="#handleCancel" style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8;" text="Annuler" />
        <Button onAction="#handleUpdate" style="-fx-background-color:linear-gradient(to right,#f59e0b,#d97706); -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold;" text="Mettre à jour" />
    </HBox>
</VBox>
