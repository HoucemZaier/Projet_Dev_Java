<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.editPrive">

    <VBox alignment="TOP_CENTER" prefHeight="400" prefWidth="600" spacing="20">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #4CAF50; -fx-padding: 15;">
            <!-- Emoji voiture -->
            <Label style="-fx-font-size: 24;" text="🚗" />

            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Mettre à jour un Transport Privé" />
                <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="Modifiez les informations de la voiture de location" />
            </VBox>
        </HBox>

        <!-- Formulaire -->
        <GridPane alignment="CENTER" hgap="15" style="-fx-padding: 20;" vgap="15">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Prix de Location -->
            <Label text="Prix de Location (€/jour) *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="prixLocationField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- État -->
            <Label text="État *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="etatField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Bouton -->
        <Button fx:id="updateButton" onAction="#handleUpdateCar" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Mettre à jour la Voiture" />
    </VBox>
</AnchorPane>
