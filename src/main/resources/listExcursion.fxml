<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="700.0" prefWidth="1050.0" spacing="0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ListExcursionController">

    <!-- ================= HEADER ================= -->
    <BorderPane style="-fx-background-color: white;                        -fx-padding: 20 25;                        -fx-border-color: #e2e8f0;                        -fx-border-width: 0 0 1 0;">
        <left>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Rectangle arcHeight="5" arcWidth="5" fill="#10b981" height="30" width="4" />
                    <Label style="-fx-text-fill: #1e293b;" text="Gestion des Excursions">
                        <font><Font name="Segoe UI Semibold" size="22" /></font>
                    </Label>
                </HBox>
                <Label style="-fx-text-fill: #64748b;" text="Ajoutez, modifiez, supprimez — Carte OpenStreetMap intégrée">
                    <font><Font name="Segoe UI" size="13" /></font>
                </Label>
            </VBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <!-- ✅ NOUVEAU : Bouton Chatbot IA -->
                <Button onAction="#handleChatbot" prefHeight="46" prefWidth="140" style="-fx-background-color: linear-gradient(to right,#7c3aed,#6d28d9);                                -fx-text-fill: white;                                -fx-background-radius: 8;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="🤖 PlanovaBot">
                    <effect><DropShadow color="rgba(124,58,237,0.3)" offsetY="4" radius="8" /></effect>
                </Button>

                <!-- ✅ NOUVEAU : Bouton Calendrier -->
                <Button onAction="#handleCalendar" prefHeight="46" prefWidth="140" style="-fx-background-color: linear-gradient(to right,#f59e0b,#d97706);                                -fx-text-fill: white;                                -fx-background-radius: 8;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="📅 Calendrier">
                    <effect><DropShadow color="rgba(245,158,11,0.3)" offsetY="4" radius="8" /></effect>
                </Button>

                <!-- Bouton Ajouter -->
                <Button onAction="#handleAjouterExcursion" prefHeight="46" prefWidth="160" style="-fx-background-color: linear-gradient(to right,#10b981,#0DA2E7);                                -fx-text-fill: white;                                -fx-background-radius: 8;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="+ Ajouter Excursion">
                    <effect><DropShadow color="rgba(16,185,129,0.3)" offsetY="4" radius="8" /></effect>
                </Button>
            </HBox>
        </right>
    </BorderPane>

    <!-- ================= FILTRES — RECHERCHE AJAX ================= -->
    <VBox style="-fx-padding: 15 25 5 25; -fx-background-color: white;                  -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <!-- Champ recherche AJAX temps réel -->
            <VBox HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label style="-fx-font-size:16px;" text="🔍" />
                    <TextField fx:id="txtRecherche" prefHeight="44" prefWidth="669.0" promptText="Recherche en temps réel par titre ou destination..." style="-fx-background-radius: 8;                                       -fx-background-color: #f8fafc;                                       -fx-border-color: #cbd5e1;                                       -fx-border-radius: 8;                                       -fx-border-width: 1.5;                                       -fx-padding: 0 15;                                       -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                </HBox>
                <!-- Feedback résultat temps réel -->
                <Label fx:id="searchResultLabel" style="-fx-font-size: 11px; -fx-padding: 3 0 0 28;" text="" />
            </VBox>

            <ComboBox fx:id="statutFilter" prefHeight="48.0" prefWidth="160" promptText="Filtrer par statut" style="-fx-background-radius:8;" />

            <Button onAction="#handleFavoris" prefHeight="44" style="-fx-background-color:#f59e0b;                            -fx-text-fill:white;                            -fx-background-radius:8;                            -fx-font-weight:bold;                            -fx-cursor:hand;                            -fx-padding: 0 16;" text="⭐ Favoris" />
        </HBox>
    </VBox>

    <!-- ================= LISTE ================= -->
    <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
        </content>
    </ScrollPane>
</VBox>
