<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="1000.0"
      prefHeight="650.0"
      spacing="0"
      style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ListExcursionController">

    <!-- ================= HEADER ================= -->
    <BorderPane style="-fx-background-color: white;
                       -fx-padding: 20 25;
                       -fx-border-color: #e2e8f0;
                       -fx-border-width: 0 0 1 0;">

        <left>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Rectangle arcHeight="5"
                               arcWidth="5"
                               fill="#10b981"
                               height="30"
                               width="4"/>
                    <Label text="Gestion des Excursions"
                           style="-fx-text-fill: #1e293b;">
                        <font>
                            <Font name="Segoe UI Semibold" size="22"/>
                        </font>
                    </Label>
                </HBox>

                <Label text="Ajoutez, modifiez ou supprimez des excursions."
                       style="-fx-text-fill: #64748b;">
                    <font>
                        <Font name="Segoe UI" size="13"/>
                    </font>
                </Label>
            </VBox>
        </left>

        <right>
            <Button text="+ Ajouter Excursion"
                    onAction="#handleAjouterExcursion"
                    prefHeight="45"
                    style="-fx-background-color: linear-gradient(to right,#10b981,#0DA2E7);
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;">
                <effect>
                    <DropShadow color="rgba(16,185,129,0.3)"
                                offsetY="4"
                                radius="8"/>
                </effect>
            </Button>
        </right>
    </BorderPane>

    <!-- ================= FILTRES ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="15"
          style="-fx-padding:15 25;">

        <TextField fx:id="txtRecherche"
                   promptText="Rechercher par titre ou destination"
                   prefHeight="45"
                   prefWidth="260"
                   style="-fx-background-radius: 8;
                          -fx-background-color: white;
                          -fx-border-color: #cbd5e1;
                          -fx-border-radius: 8;
                          -fx-border-width: 1.5;
                          -fx-padding: 0 15;" />

        <ComboBox fx:id="statutFilter"
                  prefWidth="170"
                  promptText="Filtrer par statut"
                  style="-fx-background-radius:8;" />

        <Button text="Liste des Favoris"
                onAction="#handleFavoris"
                style="-fx-background-color:#f59e0b;
                       -fx-text-fill:white;
                       -fx-background-radius:8;
                       -fx-font-weight:bold;
                       -fx-cursor:hand;" />

        <Button text="Notifications"
                onAction="#handleNotifications"
                style="-fx-background-color:#10b981;
                       -fx-text-fill:white;
                       -fx-background-radius:8;
                       -fx-font-weight:bold;
                       -fx-cursor:hand;" />

    </HBox>

    <!-- ================= LISTE ================= -->
    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">

        <content>
            <VBox fx:id="containerExcursions"
                  spacing="15"
                  style="-fx-padding: 25;" />
        </content>

    </ScrollPane>

</VBox>
