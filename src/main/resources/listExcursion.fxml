<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0" prefWidth="1000.0" spacing="0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ListExcursionController">

    <!-- HEADER -->
    <BorderPane style="-fx-background-color: white; -fx-padding: 20 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <left>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Rectangle arcHeight="5" arcWidth="5" fill="#10b981" height="30" width="4" />
                    <Label style="-fx-text-fill: #1e293b;" text="Gestion des Excursions">
                        <font>
                            <Font name="Segoe UI Semibold" size="22" />
                        </font>
                    </Label>
                </HBox>
                <Label style="-fx-text-fill: #64748b;" text="Ajoutez, modifiez ou supprimez des excursions.">
                    <font>
                        <Font name="Segoe UI" size="13" />
                    </font>
                </Label>
            </VBox>
        </left>

        <right>
            <Button onAction="#handleAjouterExcursion" prefHeight="40" prefWidth="180" style="-fx-background-color: linear-gradient(to right,#10b981,#059669); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="+ Ajouter Excursion">
                <effect>
                    <DropShadow color="rgba(16,185,129,0.3)" offsetY="4" radius="8" />
                </effect>
                <padding>
                    <Insets bottom="10" left="20" right="20" top="10" />
                </padding>
            </Button>
        </right>
    </BorderPane>

    <!-- SEARCH BAR -->
    <BorderPane style="-fx-background-color: white; -fx-padding: 20 25; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <left>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <TextField fx:id="txtRecherche" prefHeight="40" prefWidth="233.0" promptText="Rechercher par titre ou destination" style="-fx-background-radius: 8; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 0 15;" />
                <Button onAction="#handleRechercher" prefHeight="40" prefWidth="156.0" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Rechercher" />
            </HBox>
        </left>
    </BorderPane>

    <!-- TABLE -->
    <VBox spacing="15" style="-fx-padding: 25;">
        <TableView fx:id="tableExcursion">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="titreColumn" text="Titre" />
                <TableColumn fx:id="destinationColumn" text="Destination" />
                <TableColumn fx:id="dateDepartColumn" text="Date Départ" />
                <TableColumn fx:id="dateRetourColumn" text="Date Retour" />
                <TableColumn fx:id="prixColumn" text="Prix" />
                <TableColumn fx:id="nbPlacesColumn" text="Nb Places" />
                <TableColumn fx:id="statutColumn" text="Statut" />
                <TableColumn fx:id="actionColumn" text="Actions" />
            </columns>
        </TableView>
    </VBox>

</VBox>
