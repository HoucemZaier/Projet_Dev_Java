<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650" prefWidth="750"
      spacing="0"
      style="-fx-background-color:#f8fafc;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CreateActiviteController">

    <!-- HEADER -->
    <BorderPane style="-fx-background-color:white; -fx-padding:20 25; -fx-border-color:#e2e8f0; -fx-border-width:0 0 1 0;">
        <left>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle width="4" height="30" fill="#10b981" arcWidth="5" arcHeight="5"/>
                <Label text="Ajouter une Activité">
                    <font>
                        <Font name="Segoe UI Semibold" size="22"/>
                    </font>
                </Label>
            </HBox>
        </left>
    </BorderPane>

    <!-- FORM -->
    <VBox spacing="20" style="-fx-padding:30;">
        <GridPane hgap="20" vgap="15">

            <Label text="Nom :" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Description :" GridPane.rowIndex="1"/>
            <TextArea fx:id="descriptionField"
                      prefHeight="80"
                      GridPane.rowIndex="1"
                      GridPane.columnIndex="1"/>

            <Label text="Date :" GridPane.rowIndex="2"/>
            <DatePicker fx:id="datePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Heure (HH:MM:SS) :" GridPane.rowIndex="3"/>
            <TextField fx:id="heureField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Lieu :" GridPane.rowIndex="4"/>
            <TextField fx:id="lieuField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Prix :" GridPane.rowIndex="5"/>
            <TextField fx:id="prixField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Excursion :" GridPane.rowIndex="6"/>
            <ComboBox fx:id="excursionComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Destination :" GridPane.rowIndex="7"/>
            <ComboBox fx:id="destinationComboBox" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- BUTTONS -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8;"/>
            <Button text="Enregistrer"
                    onAction="#handleSave"
                    style="-fx-background-color:linear-gradient(to right,#10b981,#059669);
                           -fx-text-fill:white;
                           -fx-background-radius:8;
                           -fx-font-weight:bold;">
                <effect>
                    <DropShadow color="rgba(16,185,129,0.4)" radius="8" offsetY="3"/>
                </effect>
            </Button>
        </HBox>
    </VBox>
</VBox>
