<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0"
      prefWidth="1000.0"
      style="-fx-background-color:#f1f5f9;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ListActiviteController">

    <!-- ================= HEADER ================= -->
    <BorderPane style="-fx-background-color: white;
                       -fx-padding: 20 25;
                       -fx-border-color: #e2e8f0;
                       -fx-border-width: 0 0 1 0;">

        <!-- LEFT TITLE -->
        <left>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Rectangle arcHeight="5" arcWidth="5"
                               fill="#10b981"
                               height="30" width="4"/>
                    <Label text="Gestion des Activités"
                           style="-fx-text-fill: #1e293b;">
                        <font>
                            <Font name="Segoe UI Semibold" size="22"/>
                        </font>
                    </Label>
                </HBox>

                <Label text="Ajoutez, modifiez ou supprimez des activités."
                       style="-fx-text-fill: #64748b;">
                    <font>
                        <Font name="Segoe UI" size="13"/>
                    </font>
                </Label>
            </VBox>
        </left>

        <!-- RIGHT BUTTONS -->
        <right>
            <HBox spacing="10" alignment="CENTER_RIGHT">

                <Button fx:id="btnNotifications"
                        onAction="#handleNotifications"
                        prefHeight="40"
                        style="-fx-background-color:#ef4444;
                               -fx-text-fill:white;
                               -fx-background-radius:8;
                               -fx-font-weight:bold;
                               -fx-cursor:hand;"
                        text="🔔 (0)" />

                <Button onAction="#handleAjouterActivite"
                        prefHeight="40"
                        style="-fx-background-color:#0DA2E7;
                               -fx-text-fill:white;
                               -fx-background-radius:8;
                               -fx-font-weight:bold;
                               -fx-padding:0 20;"
                        text="+ Ajouter Activité" />

                <Button onAction="#afficherStats"
                        prefHeight="40"
                        style="-fx-background-color:#64748b;
                               -fx-text-fill:white;
                               -fx-background-radius:8;
                               -fx-font-weight:bold;
                               -fx-padding:0 20;"
                        text="Statistique" />

            </HBox>
        </right>

    </BorderPane>

    <!-- ================= SEARCH & ACTIONS ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="10"
          style="-fx-padding:20 45;">

        <TextField fx:id="txtRecherche"
                   prefWidth="300"
                   promptText="Rechercher activité..."
                   style="-fx-background-radius:8;
                          -fx-border-radius:8;
                          -fx-border-color:#cbd5e1;
                          -fx-padding:10 15;" />

        <Button fx:id="btnTriPrix"
                onAction="#trierPrixDynamic"
                style="-fx-background-radius:8;
                       -fx-border-radius:8;
                       -fx-border-color:#cbd5e1;
                       -fx-background-color:white;"
                text="Trier par prix ⬆" />

        <Button onAction="#handleFavoris"
                style="-fx-background-color:#f59e0b;
                       -fx-text-fill:white;
                       -fx-background-radius:8;
                       -fx-font-weight:bold;
                       -fx-cursor:hand;"
                text="Liste des Favoris" />

    </HBox>

    <!-- ================= LISTE DES ACTIVITES ================= -->
    <ScrollPane fitToWidth="true"
                style="-fx-background-color:transparent;">

        <content>
            <VBox fx:id="containerActivites"
                  spacing="20"
                  style="-fx-padding:20 35;" />
        </content>

    </ScrollPane>

</VBox>