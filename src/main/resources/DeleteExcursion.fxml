<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="144.0" prefWidth="288.0" spacing="15" style="-fx-padding:20; -fx-background-color:#f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.DeleteExcursionController">

    <Label text="Supprimer Excursion ?">
        <font><Font size="20" /></font>
    </Label>

    <Label fx:id="titreLabel" style="-fx-text-fill:#1e293b; -fx-font-weight:bold;" text="Titre de l'excursion" />

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <Button onAction="#handleCancel" style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8;" text="Annuler" />
        <Button onAction="#handleDelete" style="-fx-background-color:linear-gradient(to right,#f87171,#dc2626); -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold;" text="Supprimer" />
    </HBox>

</VBox>
