<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="700.0" prefWidth="950.0" spacing="0"
      style="-fx-background-color: #f8fafd;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.PlaNova.controllers.modifierHotelController">

    <!-- Header avec titre - Design premium -->
    <BorderPane style="-fx-background-color: white; -fx-padding: 25 30; -fx-border-color: transparent; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <left>
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Rectangle arcHeight="8.0" arcWidth="8.0" fill="linear-gradient(from 0% 0% to 100% 100%, #2A3B4C, #1a2935)" height="32.0" width="6.0" />
                    <Label style="-fx-text-fill: #1e293b;" text="Modifier un hôtel">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>
                </HBox>
                <Label style="-fx-text-fill: #64748b;" text="Modifiez les informations de l'hôtel sélectionné">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </VBox>
        </left>
        <right>
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Label style="-fx-text-fill: #64748b; -fx-font-style: italic; -fx-padding: 0 10 0 0;" text="* Champs obligatoires">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </HBox>
        </right>
    </BorderPane>

    <!-- Contenu principal avec scroll -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0; -fx-border-width: 0;">
        <VBox spacing="25" style="-fx-padding: 30 30 20 30;">

            <!-- Formulaire en deux colonnes avec labels d'erreur sous chaque champ -->
            <GridPane hgap="30" vgap="15">
                <columnConstraints>
                    <ColumnConstraints halignment="LEFT" prefWidth="400" />
                    <ColumnConstraints halignment="LEFT" prefWidth="400" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>

                <!-- Première colonne : Nom de l'hôtel -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Nom de l'hôtel *">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                    <TextField fx:id="nomHotelField" prefHeight="45.0" prefWidth="400.0"
                               promptText="Ex: Grand Hôtel Royal"
                               style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10; -fx-prompt-text-fill: #94a3b8; -fx-padding: 0 15;">
                        <effect>
                            <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                        </effect>
                    </TextField>
                    <Label fx:id="nomErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>

                <!-- Deuxième colonne : Ville -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Ville *">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                    <TextField fx:id="villeField" prefHeight="45.0" prefWidth="400.0"
                               promptText="Ex: Paris"
                               style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10; -fx-prompt-text-fill: #94a3b8; -fx-padding: 0 15;">
                        <effect>
                            <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                        </effect>
                    </TextField>
                    <Label fx:id="villeErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>

                <!-- Première colonne, ligne 2 : Adresse -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Adresse *">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                    <TextField fx:id="adresseField" prefHeight="45.0" prefWidth="400.0"
                               promptText="Ex: 123 Avenue des Champs-Élysées, 75008 Paris"
                               style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10; -fx-prompt-text-fill: #94a3b8; -fx-padding: 0 15;">
                        <effect>
                            <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                        </effect>
                    </TextField>
                    <Label fx:id="adresseErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>

                <!-- Deuxième colonne, ligne 2 : Nombre d'étoiles -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Nombre d'étoiles *">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="etoilesComboBox" prefHeight="45.0" prefWidth="400.0"
                              promptText="Sélectionner le nombre d'étoiles"
                              style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10;">
                        <effect>
                            <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                        </effect>
                    </ComboBox>
                    <Label fx:id="etoilesErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>

                <!-- Première colonne, ligne 3 : Image -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Image">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </Label>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="imagePathField" prefHeight="45.0" prefWidth="220.0"
                                   editable="false" promptText="Aucune image sélectionnée"
                                   style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10; -fx-prompt-text-fill: #94a3b8; -fx-padding: 0 15;">
                            <effect>
                                <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                            </effect>
                        </TextField>
                        <Button onAction="#handleParcourirImage" prefHeight="45.0" prefWidth="100.0"
                                style="-fx-background-color: #ffffff; -fx-text-fill: #1e293b; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-font-weight: 600; -fx-cursor: hand; -fx-background-radius: 10;"
                                text="Parcourir">
                            <effect>
                                <DropShadow color="#E2E8F0" height="4" radius="3" width="4" />
                            </effect>
                        </Button>
                        <Button onAction="#handleSupprimerImage" prefHeight="45.0" prefWidth="45.0"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: 600; -fx-cursor: hand; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.3), 8, 0, 0, 4);"
                                text="×">
                        </Button>
                    </HBox>
                    <Label fx:id="imageErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>

                <!-- Deuxième colonne, ligne 3 : Espace vide pour équilibrer la grille -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <!-- Espace vide -->
                </VBox>

                <!-- Description - Prend toute la largeur sur la ligne 4 -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Circle fill="#2A3B4C" radius="5" />
                        <Label style="-fx-text-fill: #334155; -fx-font-weight: 600;" text="Description *">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </HBox>
                    <TextArea fx:id="descriptionArea" prefHeight="120.0" prefWidth="780.0"
                              promptText="Décrivez l'hôtel, ses services, ses équipements..."
                              style="-fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-border-radius: 10; -fx-padding: 15; -fx-prompt-text-fill: #94a3b8;"
                              wrapText="true">
                        <effect>
                            <DropShadow color="#CBD5E1" height="3" radius="2" width="3" />
                        </effect>
                    </TextArea>
                    <Label fx:id="descriptionErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-padding: 5 0 0 15;" managed="false" visible="false" wrapText="true" />
                </VBox>
            </GridPane>

            <!-- Info-bulle d'aide pour le format d'adresse -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                <Label text="ℹ️" style="-fx-font-size: 16px;"/>
                <Label text="Format d'adresse recommandé: numéro, rue, code postal, ville (ex: 15 Rue de Rivoli, 75001 Paris)"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-style: italic;"/>
            </HBox>
        </VBox>
    </ScrollPane>

    <!-- Barre d'actions - Design élégant -->
    <BorderPane style="-fx-background-color: white; -fx-padding: 20 30; -fx-border-color: #eef2f6; -fx-border-width: 1 0 0 0;">
        <right>
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button fx:id="annulerBtn" mnemonicParsing="false" onAction="#handleAnnuler"
                        prefHeight="44.0" prefWidth="120.0"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #1e293b; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: 600; -fx-background-radius: 10;"
                        text="Annuler">
                    <effect>
                        <DropShadow color="#E2E8F0" height="4" radius="3" width="4" />
                    </effect>
                    <padding>
                        <Insets bottom="10" left="25" right="25" top="10" />
                    </padding>
                </Button>
                <Button fx:id="modifierBtn" mnemonicParsing="false" onAction="#handleModifierHotel"
                        prefHeight="44.0" prefWidth="140.0"
                        style="-fx-background-color: linear-gradient(to right, #2A3B4C, #1e2c3a); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 600; -fx-effect: dropshadow(gaussian, rgba(42,59,76,0.3), 8, 0, 0, 4);"
                        text="Modifier">
                    <padding>
                        <Insets bottom="10" left="25" right="25" top="10" />
                    </padding>
                </Button>
            </HBox>
        </right>
    </BorderPane>

</VBox>