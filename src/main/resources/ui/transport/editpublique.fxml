<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.PlaNova.controllers.editPublique">

    <VBox alignment="TOP_CENTER" prefHeight="400" prefWidth="600" spacing="20">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #4CAF50; -fx-padding: 15;">
            <!-- Emoji bus -->
            <Label style="-fx-font-size: 24;" text="🚌" />

            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Mettre à jour un Transport Public" />
                <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="Modifiez les informations du transport" />
            </VBox>
        </HBox>

        <!-- Formulaire -->
        <GridPane alignment="CENTER" hgap="15" style="-fx-padding: 20;" vgap="15">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <!-- Tarif -->
            <Label text="Tarif (TND) *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="tarifField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- Horaire -->
            <Label text="Horaire *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="horaireField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <!-- Bouton -->
        <Button fx:id="updateButton" onAction="#handleUpdateTransport" prefWidth="220" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Mettre à jour le Transport" />
    </VBox>
</AnchorPane>
