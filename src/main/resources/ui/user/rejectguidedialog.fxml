<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="400.0" maxWidth="500.0" minHeight="350.0" minWidth="450.0"
           prefHeight="380.0" prefWidth="480.0" styleClass="rejection-dialog"
           stylesheets="@../../css/rejectGuideDialog.css"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.PlaNova.controllers.RejectGuideDialogController">

   <top>
      <VBox alignment="CENTER" spacing="15.0" styleClass="dialog-header">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <!-- Error Icon -->
            <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
               <image>
                  <Image url="https://img.icons8.com/fluency/96/cancel.png" />
               </image>
            </ImageView>

            <Text fx:id="titleText" styleClass="dialog-title" text="Rejeter la Demande" />
            <Text fx:id="subtitleText" styleClass="dialog-subtitle" text="Raison du rejet pour le candidat" />
         </children>
      </VBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane-transparent">
         <content>
            <VBox spacing="15.0" styleClass="dialog-content">
               <padding>
                  <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
               </padding>
               <children>
                  <Label styleClass="input-label" text="Veuillez indiquer la raison du rejet :" />

                  <TextArea fx:id="reasonTextArea" prefRowCount="6" maxHeight="150.0"
                           promptText="Exemples :&#10;• CV non conforme aux exigences&#10;• Manque d'expérience requise&#10;• Documents incomplets&#10;• Autres critères non respectés..."
                           styleClass="reason-textarea" wrapText="true" />

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <ImageView fitHeight="16.0" fitWidth="16.0">
                           <image>
                              <Image url="https://img.icons8.com/fluency/48/info.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="info-text" text="Cette raison sera communiquée au candidat" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="15.0" styleClass="dialog-footer">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#handleCancel"
                   prefWidth="120.0" styleClass="cancel-button" text="Annuler" />

            <Button fx:id="confirmBtn" mnemonicParsing="false" onAction="#handleConfirm"
                   prefWidth="120.0" styleClass="reject-button" text="Confirmer le Rejet" />
         </children>
      </HBox>
   </bottom>

</BorderPane>
