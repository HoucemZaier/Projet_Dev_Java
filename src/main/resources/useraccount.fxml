                                                                <Label style="-fx-font-size: 12px; -fx-text-fill: #495057;" text="Données biométriques cryptées et stockées localement" />
                                                            </children>
                                                        </HBox>
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                            <children>
