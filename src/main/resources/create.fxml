<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<HBox prefWidth="1100" prefHeight="700"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CreateAccountController"
      stylesheets="@login.css">

    <!-- LEFT PANEL -->
    <VBox spacing="18"
          alignment="CENTER_LEFT"
          styleClass="left-panel"
          prefWidth="420">
        <!-- LOGO -->
        <ImageView fitWidth="70" fitHeight="70">
            <image>
                <Image url="@logo.png"/>
            </image>
        </ImageView>

        <!-- TITLE -->
        <Label text="PlaNova" styleClass="title"/>

        <!-- SUBTITLE -->
        <Label text="Votre prochaine aventure, planifiée intelligemment"
               wrapText="true"
               styleClass="subtitle"/>

        <!-- SPACE -->
        <Region prefHeight="20"/>

        <!-- USER TYPE SELECTION -->
        <ComboBox fx:id="userTypeComboBox" promptText="Select User Type" styleClass="input"/>

        <!-- DYNAMIC INPUTS BASED ON TYPE -->
        <TextField fx:id="cinField" promptText="CIN" styleClass="input" visible="false"/>
        <TextField fx:id="matriculeField" promptText="Matricule" styleClass="input" visible="false"/>
        <TextField fx:id="nomField" promptText="Last Name" styleClass="input"/>
        <TextField fx:id="prenomField" promptText="First Name" styleClass="input"/>
        <TextField fx:id="emailField" promptText="Email Address" styleClass="input"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input"/>
        <PasswordField promptText="Confirm Password" styleClass="input"/>
        <TextField fx:id="paysField" promptText="Country" styleClass="input"/>

        <!-- IMAGE UPLOAD -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Profile Image:" styleClass="image-label"/>
            <Button fx:id="imageButton" text="Choose Image" onAction="#handleImageUpload" styleClass="image-btn"/>
        </HBox>

        <!-- SPACE -->
        <Region prefHeight="15"/>

        <!-- BUTTONS -->
        <HBox spacing="15">
            <Button fx:id="createAccountBtn" onAction="#handleCreateAccount" text="Create Account" styleClass="login-btn"/>
            <Button fx:id="backToLoginBtn" onAction="#handleBackToLogin" text="Back to Login" styleClass="signup-btn"/>
        </HBox>

        <!-- SPACE -->
        <Region prefHeight="20"/>

        <!-- SOCIAL -->
        <HBox spacing="25">
            <Label text="Facebook" styleClass="social"/>
            <Label text="LinkedIn" styleClass="social"/>
            <Label text="Google" styleClass="social"/>
        </HBox>

    </VBox>
    <!-- RIGHT IMAGE -->
    <ImageView fitWidth="680" preserveRatio="true" smooth="true">
        <image>
            <Image url="@plane.jpg"/>
        </image>
    </ImageView>
</HBox>
