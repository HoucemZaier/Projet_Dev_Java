<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AfficheClientPrive"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e4ecf7);">

    <children>
        <!-- Conteneur principal type carte -->
        <VBox spacing="15" layoutX="20" layoutY="20" prefWidth="860"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0.3, 0, 4);">

            <!-- Header -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 0 0 10 0; -fx-border-color: #dde3f0; -fx-border-width: 0 0 1 0;">
                <Label text="🚗"
                       style="-fx-font-size: 26;" />
                <VBox>
                    <Label text="Location de transports privés"
                           style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1f2933;" />
                    <Label text="Choisissez une voiture et triez par prix de location"
                           style="-fx-font-size: 12; -fx-text-fill: #6b7280;" />
                </VBox>
            </HBox>

            <!-- Barre de filtres / tri -->
            <HBox spacing="20" style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                <!-- Tri par prix de location -->
                <VBox spacing="5">
                    <Label text="Trier par prix de location"
                           style="-fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <ComboBox fx:id="triPrixComboBox" promptText="Choisir un ordre"
                              style="-fx-background-radius: 6;
                                     -fx-padding: 4 8 4 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Prix Moins Cher"/>
                                <String fx:value="Prix Plus Cher"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <VBox spacing="8" style="-fx-padding: 10 0 0 0;" VBox.vgrow="ALWAYS">
                <Label text="Liste des véhicules privés"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                <!-- ListView des transports privés (affichage type cartes) -->
                <ListView fx:id="listTransportPrive" prefHeight="500" prefWidth="860" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1;
                                 -fx-padding: 0; -fx-cell-size: 120;" />
            </VBox>
        </VBox>
    </children>
</AnchorPane>