<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>

<VBox spacing="0" style="-fx-background-color:#f8fafc;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CreateExcursionController">

    <!-- HEADER -->
    <BorderPane style="-fx-background-color:white; -fx-padding:20 25; -fx-border-color:#e2e8f0; -fx-border-width:0 0 1 0;">
        <left>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle fill="#10b981" height="30" width="4"/>
                <Label text="Ajouter une Excursion">
                    <font><Font name="Segoe UI Semibold" size="22"/></font>
                </Label>
            </HBox>
        </left>
    </BorderPane>

    <!-- BODY : FORMULAIRE + CARTE -->
    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- ====== COLONNE GAUCHE : FORMULAIRE ====== -->
        <VBox spacing="10" style="-fx-padding:25; -fx-min-width:340; -fx-max-width:400;" VBox.vgrow="ALWAYS">
            <GridPane hgap="15" vgap="6">

                <!-- Titre -->
                <Label text="Titre :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titreField" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label fx:id="titreError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <!-- Destination -->
                <Label text="Destination :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="destinationComboBox" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label fx:id="destinationError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Date départ -->
                <Label text="Date départ :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateDepartPicker" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label fx:id="dateDepartError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <!-- Date retour -->
                <Label text="Date retour :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateRetourPicker" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <Label fx:id="dateRetourError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <!-- Prix -->
                <Label text="Prix (DT) :" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="prixField" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                <Label fx:id="prixError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                <!-- Nb places -->
                <Label text="Nb places :" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <TextField fx:id="nbPlacesField" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
                <Label fx:id="nbPlacesError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

                <!-- Statut -->
                <Label text="Statut :" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                <ComboBox fx:id="statutComboBox" prefHeight="34" GridPane.columnIndex="1" GridPane.rowIndex="12"/>
                <Label fx:id="statutError" style="-fx-text-fill:#ef4444;" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="13"/>

                <columnConstraints>
                    <ColumnConstraints minWidth="100" percentWidth="30"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="70"/>
                </columnConstraints>
            </GridPane>

            <Label fx:id="messageLabel" style="-fx-font-weight:bold;" visible="false"/>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="cancelButton" onAction="#handleCancel" text="Annuler"
                        style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8; -fx-cursor:hand; -fx-padding:9 20;"/>
                <Button fx:id="saveButton" onAction="#handleSave" text="✓ Enregistrer"
                        style="-fx-background-color:linear-gradient(to right,#10b981,#059669);
                               -fx-text-fill:white; -fx-background-radius:8;
                               -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:9 20;"/>
            </HBox>
        </VBox>

        <!-- SÉPARATEUR VERTICAL -->
        <Separator orientation="VERTICAL"/>

        <!-- ====== COLONNE DROITE : CARTE OSM ====== -->
        <VBox spacing="10" style="-fx-padding:25; -fx-background-color:#f8fafc;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="🗺️" style="-fx-font-size:18px;"/>
                <VBox>
                    <Label text="Position GPS — OpenStreetMap"
                           style="-fx-font-weight:bold; -fx-font-size:14px; -fx-text-fill:#1e293b;"/>
                    <Label text="Cliquez sur la carte pour sélectionner la position de l'excursion"
                           style="-fx-text-fill:#64748b; -fx-font-size:11px;"/>
                </VBox>
            </HBox>

            <!-- ANCHOR POUR LA CARTE - SOLUTION CLÉ -->
            <AnchorPane VBox.vgrow="ALWAYS" prefHeight="220"
                        style="-fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-border-width:1.5; -fx-background-color: #e5e7eb;">
                <WebView fx:id="mapWebView"
                         AnchorPane.topAnchor="0.0"
                         AnchorPane.bottomAnchor="0.0"
                         AnchorPane.leftAnchor="0.0"
                         AnchorPane.rightAnchor="0.0"
                         style="-fx-background-color: transparent;"/>
            </AnchorPane>

            <!-- Coordonnées sélectionnées -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color:white; -fx-padding:10 14; -fx-background-radius:8;
                         -fx-border-color:#e2e8f0; -fx-border-radius:8; -fx-border-width:1;">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Latitude" style="-fx-font-size:10px; -fx-text-fill:#94a3b8; -fx-font-weight:bold;"/>
                    <Label fx:id="latLabel" text="—"
                           style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                </VBox>
                <Separator orientation="VERTICAL"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Longitude" style="-fx-font-size:10px; -fx-text-fill:#94a3b8; -fx-font-weight:bold;"/>
                    <Label fx:id="lngLabel" text="—"
                           style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1e293b;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleResetLocation" text="🔄 Réinitialiser"
                        style="-fx-background-color:#f1f5f9; -fx-text-fill:#64748b;
                               -fx-background-radius:7; -fx-cursor:hand; -fx-font-size:11px; -fx-padding:6 12;"/>
            </HBox>

            <Label fx:id="mapHintLabel" text="💡 Facultatif — Cliquez sur la carte pour enregistrer la localisation"
                   style="-fx-text-fill:#64748b; -fx-font-size:11px; -fx-font-style:italic;"/>
        </VBox>
    </HBox>
</VBox>