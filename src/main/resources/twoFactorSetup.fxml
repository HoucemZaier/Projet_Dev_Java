<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.TwoFactorSetupController"
            prefWidth="600" prefHeight="700"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane"
            stylesheets="@twoFactorSetup.css">

<VBox styleClass="setup-container"
      spacing="25"
      alignment="CENTER">

    <!-- Header -->
    <VBox spacing="10" alignment="CENTER">
        <Text text="Configuration Authentification à Double Facteur"
              fill="#2C3E50" styleClass="title-text">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Text>
        <Text text="Choisissez votre méthode d'authentification préférée"
              fill="#7F8C8D" styleClass="subtitle-text">
            <font>
                <Font name="System" size="14"/>
            </font>
        </Text>
    </VBox>

    <!-- Separator -->
    <Separator styleClass="separator"/>

    <!-- Authentication Options -->
    <VBox spacing="20" maxWidth="500">

        <!-- Face ID Option -->
        <VBox spacing="15" styleClass="option-container">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane prefWidth="50" prefHeight="50">
                    <Circle radius="25" fill="#3498DB" styleClass="option-icon"/>
                    <Text text="👤" fill="WHITE" styleClass="icon-text">
                        <font>
                            <Font size="20"/>
                        </font>
                    </Text>
                </StackPane>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Text text="Reconnaissance Faciale" fill="#2C3E50" styleClass="option-title">
                        <font>
                            <Font name="System Bold" size="16"/>
                        </font>
                    </Text>
                    <Text text="Utilisez votre visage pour une authentification rapide et sécurisée"
                          fill="#7F8C8D" styleClass="option-description" wrappingWidth="300">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Text>
                </VBox>

                <Button fx:id="setupFaceIdBtn" text="Configurer"
                        onAction="#setupFaceId"
                        styleClass="primary-btn">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Button>
            </HBox>

            <!-- Face ID Status -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-container">
                <Text fx:id="faceIdStatusIcon" text="⚪" fill="#BDC3C7"/>
                <Text fx:id="faceIdStatusText" text="Non configuré" fill="#7F8C8D" styleClass="status-text">
                    <font>
                        <Font size="12"/>
                    </font>
                </Text>
            </HBox>
        </VBox>

        <!-- Separator -->
        <Separator styleClass="option-separator"/>

        <!-- Microsoft Authenticator Option -->
        <VBox spacing="15" styleClass="option-container">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane prefWidth="50" prefHeight="50">
                    <Circle radius="25" fill="#E74C3C" styleClass="option-icon"/>
                    <Text text="🔐" fill="WHITE" styleClass="icon-text">
                        <font>
                            <Font size="20"/>
                        </font>
                    </Text>
                </StackPane>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Text text="Microsoft Authenticator" fill="#2C3E50" styleClass="option-title">
                        <font>
                            <Font name="System Bold" size="16"/>
                        </font>
                    </Text>
                    <Text text="Générez des codes de sécurité temporaires avec l'app Microsoft Authenticator"
                          fill="#7F8C8D" styleClass="option-description" wrappingWidth="300">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Text>
                </VBox>

                <Button fx:id="setupTotpBtn" text="Configurer"
                        onAction="#setupTotp"
                        styleClass="primary-btn">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Button>
            </HBox>

            <!-- TOTP Status -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-container">
                <Text fx:id="totpStatusIcon" text="⚪" fill="#BDC3C7"/>
                <Text fx:id="totpStatusText" text="Non configuré" fill="#7F8C8D" styleClass="status-text">
                    <font>
                        <Font size="12"/>
                    </font>
                </Text>
            </HBox>
        </VBox>

    </VBox>

    <!-- QR Code Section (Initially Hidden) -->
    <VBox fx:id="qrCodeSection" spacing="20" alignment="CENTER"
          styleClass="qr-section" visible="false" managed="false">

        <Text text="Scannez ce QR code avec Microsoft Authenticator"
              fill="#2C3E50" styleClass="qr-title">
            <font>
                <Font name="System Bold" size="16"/>
            </font>
        </Text>

        <StackPane styleClass="qr-container">
            <Rectangle width="220" height="220"
                       fill="WHITE"
                       stroke="#E1E8ED"
                       strokeWidth="2"
                       arcWidth="10"
                       arcHeight="10"/>
            <ImageView fx:id="qrCodeImage" fitWidth="200" fitHeight="200"/>
        </StackPane>

        <VBox spacing="10" alignment="CENTER">
            <Text text="Code secret (sauvegarde manuelle):" fill="#7F8C8D">
                <font>
                    <Font size="12"/>
                </font>
            </Text>
            <TextField fx:id="secretKeyField" editable="false"
                       styleClass="secret-field" maxWidth="300"/>
        </VBox>

        <!-- Verification Section -->
        <VBox spacing="15" alignment="CENTER" styleClass="verification-section">
            <Text text="Entrez le code à 6 chiffres pour vérifier:"
                  fill="#2C3E50" styleClass="verify-text">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Text>

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="verificationCodeField"
                           promptText="000000"
                           styleClass="verification-input"
                           maxWidth="120"/>
                <Button fx:id="verifyCodeBtn" text="Vérifier"
                        onAction="#verifyTotpCode"
                        styleClass="verify-btn">
                    <font>
                        <Font name="System Bold" size="12"/>
                    </font>
                </Button>
            </HBox>

            <Text fx:id="verificationMessage" fill="#E74C3C" styleClass="message-text">
                <font>
                    <Font size="12"/>
                </font>
            </Text>
        </VBox>
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="saveBtn" text="Enregistrer"
                onAction="#saveConfiguration"
                styleClass="success-btn"
                disable="true">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Button>

        <Button fx:id="cancelBtn" text="Annuler"
                onAction="#closeDialog"
                styleClass="cancel-btn">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Button>
    </HBox>

</VBox>

</ScrollPane>

