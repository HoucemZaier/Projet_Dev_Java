<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import javafx.fxml.*?>
<?import java.lang.String?>
<AnchorPane prefHeight="650.0" prefWidth="750.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AjouterTransportPublique">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #1976D2; -fx-padding: 20;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox spacing="5">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Ajouter un Transport Publique" textFill="white" />
            <Label style="-fx-font-size: 12px; -fx-opacity: 0.9;" text="Remplissez les informations du nouveau transport" textFill="white" />
        </VBox>
    </HBox>

    <!-- Main Content -->
    <VBox spacing="25" AnchorPane.bottomAnchor="25" AnchorPane.leftAnchor="25" AnchorPane.rightAnchor="25" AnchorPane.topAnchor="100">

        <!-- Informations de Base Section -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Informations de Base" />

            <Separator />

            <HBox spacing="20">
                <!-- Type de Transport -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="Type de Transport *" />
                    <ComboBox fx:id="typeTransportCombo" prefWidth="300" promptText="Sélectionner un type" style="-fx-background-radius: 5; -fx-border-radius: 5;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="🚌 Bus" />
                                <String fx:value="🚕 Taxi" />
                                <String fx:value="🚇 Métro" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <!-- Tarif (TND) -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="Tarif (TND) *" />
                    <TextField fx:id="tarifField" prefWidth="300" style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                </VBox>
            </HBox>

            <!-- Horaire Field -->
            <VBox spacing="8">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="Horaire *" />
                <TextField fx:id="horaireField" style="-fx-background-radius: 5; -fx-border-radius: 5;" />
            </VBox>

        </VBox>

        <!-- Image du Transport Section -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Image du Transport" />

            <Separator />

            <!-- Upload Area -->
            <VBox fx:id="uploadArea" alignment="CENTER" spacing="15" style="-fx-border-color: #ddd; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 40;">

                <Label style="-fx-font-size: 14px; -fx-text-fill: #333;" text="Cliquez pour télécharger une image" />
                <Label style="-fx-font-size: 12px; -fx-text-fill: #666;" text="PNG, JPG ou JPEG (max. 5MB)" />

                <Button fx:id="uploadButton" onAction="#handleUploadImage" style="-fx-background-color: transparent; -fx-text-fill: #1976D2; -fx-cursor: hand;" text="Parcourir" />
            </VBox>

        </VBox>

        <!-- Save Button -->
        <HBox alignment="CENTER">
            <Button fx:id="saveButton" onAction="#handleSaveTransport" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 5; -fx-cursor: hand;" text="Enregistrer le Transport" />
        </HBox>

    </VBox>

</AnchorPane>
