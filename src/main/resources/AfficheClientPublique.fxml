<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AfficheClientPublique"
            prefHeight="700.0" prefWidth="900.0"
            style="-fx-background-color: #f5f7fa;">

    <children>
        <!-- Conteneur principal en VBox pour un affichage clair et organisé -->
        <VBox spacing="15"
              AnchorPane.topAnchor="15" AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15" AnchorPane.bottomAnchor="15"
              style="-fx-background-color: white;
                     -fx-padding: 18;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.3, 0, 4);"
              VBox.vgrow="ALWAYS">

            <!-- En-tête -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 0 0 8 0; -fx-border-color: #d1d5db; -fx-border-width: 0 0 1 0;">
                <Label text="🚍"
                       style="-fx-font-size: 24;" />
                <VBox>
                    <Label text=" Transports publics disponibles"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Label text="Consultez les moyens de transport publics avec recherche et tri"
                           style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                </VBox>
            </HBox>

            <!-- Zone de recherche et tri -->
            <HBox spacing="15"
                  style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                <VBox spacing="4">
                    <Label text="recherche par type"
                           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12;" />
                    <ComboBox fx:id="comboRechercheType" promptText="Tous les types"
                              style="-fx-background-radius: 6; -fx-padding: 4 8 4 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <!-- Option qui affiche tous les transports -->
                                <String fx:value="Tous"/>
                                <!-- Options individuelles -->
                                <String fx:value="🚌 Bus"/>
                                <String fx:value="🚕 Taxi"/>
                                <String fx:value="🚇 Metro"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox spacing="4">
                    <Label text="Trier les transports"
                           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12;" />
                    <ComboBox fx:id="comboTri" promptText="Choisir un critère"
                              style="-fx-background-radius: 6; -fx-padding: 4 8 4 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Tarif"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Section liste avec VBox pour plus de clarté -->
            <VBox spacing="6" VBox.vgrow="NEVER" style="-fx-max-height: 350;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Liste des transports publics"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnVoirItineraire" text="🗺️ Voir Itinéraire"
                            style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 6;
                                   -fx-padding: 8 16; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-cursor: hand;" />
                    <Button fx:id="btnAfficherMap" text="🗺️ Afficher la carte" 
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 6;
                                   -fx-padding: 8 16; -fx-font-weight: bold; -fx-font-size: 12;
                                   -fx-cursor: hand;" />
                </HBox>

                <!-- ListView des transports (affichage type cartes) -->
                <ListView fx:id="listTransportPublique" prefHeight="280" prefWidth="720" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1;
                                 -fx-padding: 0; -fx-cell-size: 120;" />
            </VBox>

            <!-- Section Carte -->
            <VBox spacing="6" VBox.vgrow="ALWAYS" style="-fx-min-height: 250;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📍 Carte interactive"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnClearMap" text="🔄 Effacer"
                            style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6;
                                   -fx-padding: 6 12; -fx-font-weight: bold; -fx-font-size: 11;
                                   -fx-cursor: hand;" />
                </HBox>
                
                <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS" 
                         style="-fx-background-color: transparent; -fx-border-radius: 0; -fx-border-width: 0; -fx-max-height: 400;" />
            </VBox>
        </VBox>
    </children>
</AnchorPane>
