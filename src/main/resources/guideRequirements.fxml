<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="600.0" prefWidth="500.0"
           style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.GuideRequirementsController">

   <center>
      <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10); -fx-padding: 30;">

         <!-- HEADER -->
         <HBox alignment="CENTER" spacing="15.0">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/guide-icon.png"/>
               </image>
            </ImageView>
            <VBox alignment="CENTER_LEFT">
               <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Devenir Guide de Voyage"/>
               <Label style="-fx-font-size: 14px; -fx-text-fill: #6c757d;" text="Rejoignez notre équipe de guides professionnels"/>
            </VBox>
         </HBox>

         <Separator prefWidth="400.0"/>

         <!-- REQUIREMENTS SECTION -->
         <ScrollPane fitToWidth="true" prefHeight="300.0" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20.0" style="-fx-padding: 10;">

               <!-- QUALIFICATIONS -->
               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="🎓 Qualifications Requises:"/>
                  <VBox spacing="5.0" style="-fx-padding: 0 0 0 20;">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Expérience en tourisme ou secteur connexe (minimum 2 ans)"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Excellente connaissance des destinations touristiques"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Maîtrise de l'français et d'au moins une langue étrangère"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Compétences en communication et relations interpersonnelles"/>
                  </VBox>
               </VBox>

               <!-- RESPONSIBILITIES -->
               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #17a2b8;" text="🎯 Responsabilités:"/>
                  <VBox spacing="5.0" style="-fx-padding: 0 0 0 20;">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Organiser et conduire des excursions touristiques"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Assurer la sécurité et le bien-être des clients"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Fournir des informations culturelles et historiques"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Gérer les réservations et les itinéraires"/>
                  </VBox>
               </VBox>

               <!-- BENEFITS -->
               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6f42c1;" text="✨ Avantages:"/>
                  <VBox spacing="5.0" style="-fx-padding: 0 0 0 20;">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Rémunération attractive et commissions"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Formations continues et certifications"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Voyages gratuits et réductions"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Environnement de travail dynamique"/>
                  </VBox>
               </VBox>

               <!-- CONDITIONS -->
               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #dc3545;" text="⚠️ Conditions Importantes:"/>
                  <VBox spacing="5.0" style="-fx-padding: 0 0 0 20;">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Disponibilité weekends et jours fériés"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Capacité à marcher et rester debout longtemps"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Adaptabilité aux différentes conditions météo"/>
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #495057;" text="• Engagement de professionnalisme constant"/>
                  </VBox>
               </VBox>

            </VBox>
         </ScrollPane>

         <Separator prefWidth="400.0"/>

         <!-- CV UPLOAD SECTION -->
         <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #fff3cd; -fx-background-radius: 10; -fx-padding: 20;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #856404;" text="📄 Téléchargement du CV"/>
            <Label fx:id="cvStatusLabel" style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-text-alignment: center;"
                   text="Veuillez télécharger votre CV (PDF, DOC, DOCX - Max 5MB)" wrapText="true"/>
            <Button fx:id="uploadCvBtn" mnemonicParsing="false" onAction="#handleUploadCV"
                   style="-fx-background-color: #ffc107; -fx-background-radius: 20; -fx-text-fill: #212529; -fx-font-weight: bold; -fx-padding: 12 25; -fx-font-size: 13px; -fx-effect: dropshadow(gaussian, rgba(255,193,7,0.4), 10, 0, 0, 3); -fx-cursor: hand;"
                   text="📎 Choisir CV">
               <font>
                  <Font name="System Bold" size="13.0"/>
               </font>
            </Button>
         </VBox>

         <Separator prefWidth="400.0"/>

         <!-- CONFIRMATION MESSAGE -->
         <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #e3f2fd; -fx-background-radius: 10; -fx-padding: 15;">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1976d2;" text="🚀 Prêt(e) à rejoindre notre équipe?"/>
            <Label style="-fx-font-size: 12px; -fx-text-fill: #424242; -fx-text-alignment: center;"
                   text="En confirmant, votre demande sera envoyée à l'administration pour révision." wrapText="true"/>
         </VBox>

         <!-- ACTION BUTTONS -->
         <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="confirmBtn" mnemonicParsing="false" onAction="#handleConfirm"
                   style="-fx-background-color: #28a745; -fx-background-radius: 25; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 30; -fx-font-size: 14px; -fx-effect: dropshadow(gaussian, rgba(40,167,69,0.4), 15, 0, 0, 5); -fx-cursor: hand;"
                   text="📋 Envoyer la Demande">
               <font>
                  <Font name="System Bold" size="14.0"/>
               </font>
            </Button>
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#handleCancel"
                   style="-fx-background-color: transparent; -fx-border-color: #6c757d; -fx-border-width: 2; -fx-border-radius: 25; -fx-text-fill: #6c757d; -fx-font-weight: bold; -fx-padding: 15 30; -fx-font-size: 14px; -fx-cursor: hand;"
                   text="Annuler">
               <font>
                  <Font size="14.0"/>
               </font>
            </Button>
         </HBox>

      </VBox>
   </center>

</BorderPane>
