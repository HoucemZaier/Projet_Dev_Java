<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.affichierPublique"
            prefHeight="450.0" prefWidth="750.0"
            style="-fx-background-color: linear-gradient(to bottom, #f5f7fa, #e5ecf6);">

    <children>
        <!-- Conteneur principal en VBox pour un affichage clair et organisé -->
        <VBox spacing="15"
              AnchorPane.topAnchor="15" AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15" AnchorPane.bottomAnchor="15"
              style="-fx-background-color: white;
                     -fx-padding: 18;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.3, 0, 4);">

            <!-- En-tête -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 0 0 8 0; -fx-border-color: #d1d5db; -fx-border-width: 0 0 1 0;">
                <Label text="🚍"
                       style="-fx-font-size: 24;" />
                <VBox>
                    <Label text="Transports publics"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <Label text="Recherche, tri et gestion des moyens de transport publics"
                           style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                </VBox>
            </HBox>

            <!-- Zone de recherche et tri -->
            <HBox spacing="15"
                  style="-fx-padding: 10; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                <VBox spacing="4">
                    <Label text="Filtrer par type"
                           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12;" />
                    <ComboBox fx:id="comboRechercheType" promptText="Tous les types"
                              style="-fx-background-radius: 6; -fx-padding: 4 8 4 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="🚌 Bus"/>
                                <String fx:value="🚕 Taxi"/>
                                <String fx:value="🚇 Metro"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox spacing="4">
                    <Label text="Trier les transports"
                           style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12;" />
                    <ComboBox fx:id="comboTri" promptText="Choisir un critère"
                              style="-fx-background-radius: 6; -fx-padding: 4 8 4 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Tarif"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Bouton stylisé -->
                <Button fx:id="btnAjouter" text="Ajouter un transport"
                        prefHeight="36"
                        style="-fx-background-color: linear-gradient(to right, #3b82f6, #2563eb);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 13;
                               -fx-padding: 6 14 6 14;
                               -fx-background-radius: 999;
                               -fx-cursor: hand;">
                    <graphic>
                        <Label text="+"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 18;
                                      -fx-font-weight: bold;
                                      -fx-padding: 0 6 0 0;"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Section liste avec VBox pour plus de clarté -->
            <VBox spacing="6">
                <Label text="Liste des transports publics"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                <!-- Tableau des transports -->
                <TableView fx:id="tableWidget" prefHeight="320" prefWidth="720"
                           style="-fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-border-color: #e5e7eb;
                                  -fx-border-width: 1;
                                  -fx-table-cell-border-color: #eef2f7;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"
                                     style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colImage" text="Image" prefWidth="120"
                                     style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colTarif" text="Tarif (DT)" prefWidth="110"
                                     style="-fx-alignment: CENTER-RIGHT;" />
                        <TableColumn fx:id="colHoraire" text="Horaire" prefWidth="150"
                                     style="-fx-alignment: CENTER;" />

                        <!-- Colonne Actions : les boutons seront injectés par le contrôleur -->
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="160"
                                     style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </children>
</AnchorPane>