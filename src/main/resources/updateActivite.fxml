<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650" prefWidth="750"
      spacing="0"
      style="-fx-background-color:#f8fafc;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.UpdateActiviteController">

    <!-- Champ caché pour l'ID -->
    <TextField fx:id="idField" visible="false"/>

    <!-- HEADER -->
    <BorderPane style="-fx-background-color:white; -fx-padding:20 25; -fx-border-color:#e2e8f0; -fx-border-width:0 0 1 0;">
        <left>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle width="4" height="30" fill="#f59e0b"/>
                <Label text="Modifier Activité">
                    <font>
                        <Font name="Segoe UI Semibold" size="22"/>
                    </font>
                </Label>
            </HBox>
        </left>
    </BorderPane>

    <!-- FORMULAIRE -->
    <VBox spacing="20" style="-fx-padding:30;">
        <GridPane hgap="20" vgap="15">

            <Label text="Nom :" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Description :" GridPane.rowIndex="1"/>
            <TextArea fx:id="descriptionField" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Date :" GridPane.rowIndex="2"/>
            <DatePicker fx:id="datePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Heure (HH:MM:SS) :" GridPane.rowIndex="3"/>
            <TextField fx:id="heureField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Lieu :" GridPane.rowIndex="4"/>
            <TextField fx:id="lieuField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Prix :" GridPane.rowIndex="5"/>
            <TextField fx:id="prixField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="ID Excursion :" GridPane.rowIndex="6"/>
            <TextField fx:id="excursionField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="ID Destination :" GridPane.rowIndex="7"/>
            <TextField fx:id="destinationField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        </GridPane>

        <!-- BOUTONS -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-background-radius:8;"/>

            <Button text="Mettre à jour"
                    onAction="#handleUpdate"
                    style="-fx-background-color:linear-gradient(to right,#f59e0b,#d97706);
                           -fx-text-fill:white;
                           -fx-background-radius:8;
                           -fx-font-weight:bold;"/>
        </HBox>
    </VBox>
</VBox>
