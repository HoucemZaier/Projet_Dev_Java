<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane prefWidth="800" prefHeight="600"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controllers.AutoFaceLoginController"
           styleClass="main-container"
           stylesheets="@autoFaceLogin.css">

    <!-- Background -->
    <Rectangle arcWidth="20" arcHeight="20"
               width="800" height="600">
        <fill>
            <LinearGradient startX="0" startY="0" endX="1" endY="1">
                <stops>
                    <Stop color="#667eea" offset="0"/>
                    <Stop color="#764ba2" offset="1"/>
                </stops>
            </LinearGradient>
        </fill>
    </Rectangle>

    <!-- Main Content -->
    <VBox spacing="30" alignment="CENTER" maxWidth="450">

        <!-- Title -->
        <VBox spacing="10" alignment="CENTER">
            <!-- Logo -->
            <ImageView fitWidth="80" fitHeight="80">
                <image>
                    <Image url="@logo.PNG"/>
                </image>
            </ImageView>

            <Text text="PlaNova" fill="WHITE" styleClass="app-title">
                <font>
                    <Font name="System Bold" size="36"/>
                </font>
            </Text>

            <Text text="Authentification Face ID" fill="WHITE" styleClass="subtitle">
                <font>
                    <Font name="System" size="18"/>
                </font>
            </Text>
        </VBox>

        <!-- Face ID Animation -->
        <VBox spacing="25" alignment="CENTER" styleClass="face-id-container">
            <!-- iPhone-style Face ID Animation -->
            <StackPane prefWidth="200" prefHeight="200">
                <!-- Outer scanning ring -->
                <Circle fx:id="outerRing" radius="90" fill="TRANSPARENT"
                        stroke="rgba(255,255,255,0.2)" strokeWidth="2"
                        opacity="0.6" styleClass="scan-ring-outer"/>

                <!-- Middle scanning ring -->
                <Circle fx:id="middleRing" radius="70" fill="TRANSPARENT"
                        stroke="rgba(255,255,255,0.4)" strokeWidth="3"
                        opacity="0.7" styleClass="scan-ring-middle"/>

                <!-- Inner scanning ring -->
                <Circle fx:id="innerRing" radius="50" fill="TRANSPARENT"
                        stroke="rgba(255,255,255,0.6)" strokeWidth="4"
                        opacity="0.8" styleClass="scan-ring-inner"/>

                <!-- Core Face ID circle with gradient -->
                <Circle fx:id="scanCircle" radius="35" styleClass="scan-circle">
                    <fill>
                        <RadialGradient radius="1.0" centerX="0.5" centerY="0.5">
                            <stops>
                                <Stop color="rgba(74,144,226,0.8)" offset="0"/>
                                <Stop color="rgba(103,126,234,0.6)" offset="0.7"/>
                                <Stop color="rgba(118,75,162,0.4)" offset="1"/>
                            </stops>
                        </RadialGradient>
                    </fill>
                    <stroke>
                        <LinearGradient startX="0" startY="0" endX="1" endY="1">
                            <stops>
                                <Stop color="#4A90E2" offset="0"/>
                                <Stop color="#667eea" offset="1"/>
                            </stops>
                        </LinearGradient>
                    </stroke>
                    <strokeWidth>3</strokeWidth>
                </Circle>

                <!-- Scanning beam effect -->
                <Circle fx:id="scanBeam" radius="35" fill="TRANSPARENT"
                        stroke="rgba(74,144,226,0.8)" strokeWidth="2"
                        strokeDashArray="5,5" opacity="0" styleClass="scan-beam"/>

                <!-- Face ID icon -->
                <StackPane>
                    <!-- Modern Face ID grid pattern -->
                    <VBox spacing="3" alignment="CENTER" opacity="0.9">
                        <HBox spacing="3" alignment="CENTER">
                            <Circle radius="2" fill="rgba(255,255,255,0.8)"/>
                            <Circle radius="2" fill="rgba(255,255,255,0.6)"/>
                            <Circle radius="2" fill="rgba(255,255,255,0.8)"/>
                        </HBox>
                        <HBox spacing="3" alignment="CENTER">
                            <Circle radius="2" fill="rgba(255,255,255,0.6)"/>
                            <Circle radius="3" fill="rgba(255,255,255,1.0)"/>
                            <Circle radius="2" fill="rgba(255,255,255,0.6)"/>
                        </HBox>
                        <HBox spacing="3" alignment="CENTER">
                            <Circle radius="2" fill="rgba(255,255,255,0.8)"/>
                            <Circle radius="2" fill="rgba(255,255,255,0.6)"/>
                            <Circle radius="2" fill="rgba(255,255,255,0.8)"/>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- Success/Error overlay -->
                <Circle fx:id="statusOverlay" radius="35" fill="TRANSPARENT"
                        opacity="0" styleClass="status-overlay"/>

                <!-- Pulse effect circles -->
                <Circle fx:id="pulseCircle1" radius="35" fill="TRANSPARENT"
                        stroke="rgba(74,144,226,0.3)" strokeWidth="2"
                        opacity="0" styleClass="pulse-circle"/>
                <Circle fx:id="pulseCircle2" radius="35" fill="TRANSPARENT"
                        stroke="rgba(74,144,226,0.2)" strokeWidth="2"
                        opacity="0" styleClass="pulse-circle"/>
            </StackPane>

            <!-- Status Text -->
            <VBox spacing="8" alignment="CENTER">
                <Text fx:id="statusText" text="Positionnez votre visage devant la caméra"
                      fill="WHITE" textAlignment="CENTER" styleClass="status-text">
                    <font>
                        <Font name="System" size="16"/>
                    </font>
                </Text>

                <Text fx:id="attemptText" fill="#FFE5E5"
                      styleClass="attempt-text">
                    <font>
                        <Font name="System" size="14"/>
                    </font>
                </Text>
            </VBox>

            <!-- Progress Indicator -->
            <ProgressIndicator fx:id="progressIndicator" prefWidth="40" prefHeight="40"
                             visible="false" styleClass="progress"/>
        </VBox>

        <!-- Buttons -->
        <VBox spacing="15" alignment="CENTER" maxWidth="300">
            <Button fx:id="startScanBtn" text="🆔 Démarrer Face ID"
                    onAction="#startFaceScan" styleClass="face-id-btn"
                    maxWidth="Infinity" prefHeight="45">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Button>

            <Button fx:id="skipToLoginBtn" text="Utiliser Email et Mot de Passe"
                    onAction="#skipToNormalLogin" styleClass="secondary-btn"
                    maxWidth="Infinity" prefHeight="40" visible="false">
                <font>
                    <Font name="System" size="12"/>
                </font>
            </Button>
        </VBox>

        <!-- Alternative Login Info -->
        <VBox spacing="8" alignment="CENTER">
            <Text text="Tentatives restantes:" fill="#E5E5E5" styleClass="info-text">
                <font>
                    <Font name="System" size="12"/>
                </font>
            </Text>
            <Text fx:id="attemptsLeftText" text="3" fill="WHITE" styleClass="attempts-count">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Text>
        </VBox>

    </VBox>

    <!-- Close Button -->
    <Button fx:id="closeBtn" text="✕" onAction="#closeWindow"
            styleClass="close-btn"
            StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="20" right="20"/>
        </StackPane.margin>
    </Button>
</StackPane>
