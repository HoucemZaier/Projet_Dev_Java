<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="800.0" prefWidth="1280.0" styleClass="root-background"
      stylesheets="@../css/destinations.css"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.PlaNova.controllers.DestinationController">

    <!-- ======================== SIDEBAR ======================== -->
    <VBox maxWidth="210.0" prefWidth="210.0" spacing="8" styleClass="sidebar">
        <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>

        <!-- Logo -->
        <Label styleClass="logo-text" text="Planova">
            <graphic>
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../images/logo.png"/></image>
                </ImageView>
            </graphic>
        </Label>

        <!-- Navigation -->
        <VBox spacing="5" VBox.vgrow="ALWAYS">
            <padding><Insets top="30"/></padding>
            <children>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Overview">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="https://img.icons8.com/ios-filled/50/5b677b/grid-2.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button-active" text="Destinations">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/images.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#navigateToBillets" styleClass="menu-button" text="Billets">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/billets.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Hotels">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/hotel.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Excursions">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/excursion.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Blog Posts">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/post.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Community Forum">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/forum.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Activities">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/activité.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </VBox>

        <!-- Bottom Settings/Logout -->
        <VBox spacing="5" styleClass="sidebar-bottom">
            <children>
                <Button maxWidth="Infinity" styleClass="menu-button" text="Settings">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/settings.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="menu-button-logout" text="Logout">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/logout.png"/></image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </VBox>

    <!-- ======================== CONTENT AREA ======================== -->
    <StackPane fx:id="contentStack" HBox.hgrow="ALWAYS">

        <!-- ==== Main Content ==== -->
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets bottom="20" left="30" right="30" top="20"/></padding>

            <!-- Header Row -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox>
                    <Label styleClass="dashboard-title" text="Destinations"/>
                    <Label styleClass="welcome-text" text="Manage your travel destinations"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="15" styleClass="top-bar-right-panel">
                    <TextField fx:id="searchField" prefWidth="220" promptText="Search destinations..." styleClass="search-field"/>
                    <Button onAction="#handleClearSearch" styleClass="clear-search-btn" text="&#x2717;"/>
                    <Button onAction="#showAddForm" styleClass="new-entry-button" text="+ New Destination"/>
                </HBox>
            </HBox>

            <!-- Stats Row -->
            <HBox spacing="20">
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Total Destinations"/>
                        <Label fx:id="totalLabel" styleClass="card-value" text="0"/>
                    </children>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Countries"/>
                        <Label fx:id="countriesLabel" styleClass="card-value" text="0"/>
                    </children>
                </VBox>
                <VBox styleClass="info-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="card-title" text="Upcoming Trips"/>
                        <Label fx:id="upcomingLabel" styleClass="card-value" text="0"/>
                    </children>
                </VBox>
            </HBox>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar">
                <padding><Insets bottom="6" left="12" right="12" top="6"/></padding>
                <CheckBox fx:id="selectAllCheck" text="Select All"/>
                <Label fx:id="selectionLabel" styleClass="selection-label" text="0 selected"/>
                <Separator orientation="VERTICAL" prefHeight="24"/>
                <Button fx:id="batchDeleteBtn" onAction="#handleBatchDelete" styleClass="toolbar-btn-danger" text="Delete Selected" managed="false" visible="false"/>
                <Button fx:id="undoBtn" onAction="#handleUndo" styleClass="toolbar-btn" text="&#x21B6; Undo" managed="false" visible="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleExportCsv" styleClass="toolbar-btn" text="&#x2913; Export CSV"/>
                <MenuButton fx:id="columnToggleBtn" styleClass="toolbar-btn" text="&#x2630; Columns"/>
                <Button fx:id="densityBtn" onAction="#handleDensityToggle" styleClass="toolbar-btn" text="Compact"/>
                <Button onAction="#handleRefresh" styleClass="toolbar-btn-accent" text="&#x21BB; Refresh"/>
            </HBox>

            <!-- Table Card -->
            <VBox spacing="0" styleClass="table-card" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="4" left="4" right="4" top="4"/></padding>
                <TableView fx:id="destinationTable" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>

        <!-- ==== Form Overlay ==== -->
        <HBox fx:id="formOverlay" managed="false" visible="false" styleClass="form-overlay">

            <!-- Backdrop -->
            <Region fx:id="backdrop" styleClass="backdrop" HBox.hgrow="ALWAYS"/>

            <!-- Form Panel -->
            <VBox fx:id="formPanel" prefWidth="420" spacing="18" styleClass="form-panel">
                <padding><Insets bottom="32" left="32" right="32" top="28"/></padding>

                <!-- Form Header -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="formTitle" styleClass="form-title" text="New Destination"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#hideForm" styleClass="close-btn" text="X"/>
                </HBox>

                <Separator/>

                <!-- Destination Name -->
                <VBox spacing="6">
                    <Label styleClass="field-label" text="Destination Name *"/>
                    <TextField fx:id="nameField" promptText="e.g. Paris, Tokyo, Bali..."
                               styleClass="form-input"/>
                    <Label fx:id="nameError" managed="false" styleClass="error-label" text="" visible="false"/>
                </VBox>

                <!-- Country -->
                <VBox spacing="6">
                    <Label styleClass="field-label" text="Country *"/>
                    <TextField fx:id="countryField" promptText="e.g. France, Japan, Indonesia..."
                               styleClass="form-input"/>
                    <Label fx:id="countryError" managed="false" styleClass="error-label" text="" visible="false"/>
                </VBox>

                <!-- Departure Date -->
                <VBox spacing="6">
                    <Label styleClass="field-label" text="Departure Date *"/>
                    <DatePicker fx:id="departurePicker" maxWidth="Infinity" styleClass="form-input"/>
                    <Label fx:id="departureError" managed="false" styleClass="error-label" text="" visible="false"/>
                </VBox>

                <!-- Arrival Date -->
                <VBox spacing="6">
                    <Label styleClass="field-label" text="Arrival Date *"/>
                    <DatePicker fx:id="arrivalPicker" maxWidth="Infinity" styleClass="form-input"/>
                    <Label fx:id="arrivalError" managed="false" styleClass="error-label" text="" visible="false"/>
                </VBox>

                <!-- Image Upload -->
                <VBox spacing="8">
                    <Label styleClass="field-label" text="Cover Image"/>
                    <Button maxWidth="Infinity" onAction="#uploadImage"
                            styleClass="upload-button" text="Choose Image..."/>
                    <ImageView fx:id="imagePreview" fitHeight="150" fitWidth="356"
                               pickOnBounds="true" preserveRatio="true"
                               styleClass="image-preview"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Action Buttons -->
                <HBox spacing="12">
                    <Button fx:id="saveBtn" maxWidth="Infinity" onAction="#handleSave"
                            styleClass="save-button" text="Save Destination" HBox.hgrow="ALWAYS"/>
                    <Button maxWidth="Infinity" onAction="#hideForm"
                            styleClass="cancel-button" text="Cancel" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- ==== Notification Toast Area ==== -->
        <VBox fx:id="notificationArea" alignment="TOP_RIGHT" mouseTransparent="true" pickOnBounds="false">
            <padding><Insets right="24" top="20"/></padding>
        </VBox>

    </StackPane>
</HBox>
