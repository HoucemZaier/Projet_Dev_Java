<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.detailsChambreController"
            style="-fx-background-color: transparent; -fx-border-width: 0;">

    <VBox spacing="25" style="-fx-background-color: #f8fafd; -fx-padding: 30;">

        <!-- En-tête avec titre et bouton fermer -->
        <BorderPane>
            <left>
                <VBox spacing="8">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Rectangle arcHeight="8.0" arcWidth="8.0"
                                   fill="linear-gradient(from 0% 0% to 100% 100%, #3A4C5D, #2A3B4C)"
                                   height="32.0" width="6.0" />
                        <Label fx:id="chambreNumberLabel" text="Chambre N° 123">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </HBox>
                    <Label fx:id="chambreTitleLabel" text="Suite Deluxe - Disponible"
                           style="-fx-text-fill: #64748b;">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                </VBox>
            </left>
            <right>
                <Button text="✕" onAction="#handleClose"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-background-radius: 20; -fx-font-size: 16; -fx-cursor: hand; -fx-padding: 8 15;" />
            </right>
        </BorderPane>

        <!-- Statut et actions rapides -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 15 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Circle fx:id="statutIndicator" radius="8" fill="#10b981" />
                <Label fx:id="statutLabel" text="Disponible" style="-fx-font-weight: 600;">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Modifier" onAction="#handleModifier"
                    style="-fx-background-color: #3A4C5D; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand;" />
            <Button text="Réserver" onAction="#handleReserver"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand;" />
            <Button text="Imprimer" onAction="#handleImprimer"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand;" />
        </HBox>

        <!-- Grille d'informations principale -->
        <GridPane hgap="20" vgap="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>

            <!-- Colonne gauche : Informations hôtel -->
            <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="HÔTEL" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <VBox spacing="12">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🏨" style="-fx-font-size: 18;" />
                        <Label fx:id="hotelNameLabel" text="Hôtel Royal"
                               style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="📍" style="-fx-font-size: 18;" />
                        <Label fx:id="hotelAddressLabel" text="15 Avenue des Champs-Élysées, Paris"
                               style="-fx-text-fill: #475569;" wrapText="true" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="📞" style="-fx-font-size: 18;" />
                        <Label fx:id="hotelPhoneLabel" text="+33 1 23 45 67 89"
                               style="-fx-text-fill: #475569;" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="✉" style="-fx-font-size: 18;" />
                        <Label fx:id="hotelEmailLabel" text="contact@hotelroyal.com"
                               style="-fx-text-fill: #475569;" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Colonne droite : Informations chambre -->
            <VBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="CHAMBRE" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <GridPane hgap="20" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40" />
                        <ColumnConstraints percentWidth="60" />
                    </columnConstraints>

                    <Label text="Type :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="chambreTypeLabel" text="Suite Deluxe"
                           style="-fx-font-weight: 600;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Capacité :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="capaciteLabel" text="4 personnes"
                           style="-fx-font-weight: 600;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Prix/nuit :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="prixLabel" text="250.00 €"
                           style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Étage :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="etageLabel" text="2ème étage"
                           style="-fx-font-weight: 600;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Vue :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="vueLabel" text="Vue sur mer"
                           style="-fx-font-weight: 600;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>
            </VBox>
        </GridPane>

        <!-- Équipements -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <Label text="ÉQUIPEMENTS" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <FlowPane hgap="10" vgap="10">
                <HBox fx:id="wifiBox" spacing="5" alignment="CENTER">
                    <Label fx:id="wifiLabel" text="Wi-Fi" />
                </HBox>

                <HBox fx:id="tvBox" spacing="5" alignment="CENTER">
                    <Label fx:id="tvLabel" text="Télévision" />
                </HBox>

                <HBox fx:id="climatisationBox" spacing="5" alignment="CENTER">
                    <Label fx:id="climatisationLabel" text="Climatisation" />
                </HBox>

                <HBox fx:id="miniBarBox" spacing="5" alignment="CENTER">
                    <Label fx:id="miniBarLabel" text="Mini-bar" />
                </HBox>

                <HBox fx:id="balconBox" spacing="5" alignment="CENTER">
                    <Label fx:id="balconLabel" text="Balcon" />
                </HBox>

                <HBox fx:id="coffreBox" spacing="5" alignment="CENTER">
                    <Label fx:id="coffreLabel" text="Coffre-fort" />
                </HBox>

                <HBox fx:id="telephoneBox" spacing="5" alignment="CENTER">
                    <Label fx:id="telephoneLabel" text="Téléphone" />
                </HBox>

                <HBox fx:id="chauffageBox" spacing="5" alignment="CENTER">
                    <Label fx:id="chauffageLabel" text="Chauffage" />
                </HBox>
            </FlowPane>
        </VBox>

        <!-- Description -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <Label text="DESCRIPTION" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <Label fx:id="descriptionLabel" text="Description de la chambre..."
                   wrapText="true" style="-fx-line-spacing: 5; -fx-text-fill: #334155;" />
        </VBox>

        <!-- Statistiques et notes -->
        <GridPane hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" />
                <ColumnConstraints percentWidth="50" />
            </columnConstraints>

            <!-- Statistiques -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="0">
                <Label text="STATISTIQUES" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40" />
                        <ColumnConstraints percentWidth="60" />
                    </columnConstraints>

                    <Label text="Date création :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="dateCreationLabel" text="15/01/2024"
                           style="-fx-font-weight: 500;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Dernière résa :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="derniereReservationLabel" text="12/02/2024"
                           style="-fx-font-weight: 500;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Total résas :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="totalReservationsLabel" text="24 réservations"
                           style="-fx-font-weight: 500;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Chiffre d'affaire :" style="-fx-text-fill: #64748b;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="chiffreAffaireLabel" text="6000.00 €"
                           style="-fx-font-weight: 700; -fx-text-fill: #10b981;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>
            </VBox>

            <!-- Notes et avis -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
                  GridPane.columnIndex="1">
                <Label text="NOTES ET AVIS" style="-fx-font-weight: 700; -fx-text-fill: #3A4C5D;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER">
                        <Label fx:id="noteLabel" text="4.5" style="-fx-font-size: 36; -fx-font-weight: 700; -fx-text-fill: #f59e0b;" />
                        <Label text="/5" style="-fx-text-fill: #64748b;" />
                    </VBox>

                    <VBox>
                        <Label fx:id="avisLabel" text="(128 avis)" style="-fx-font-size: 16; -fx-font-weight: 600;" />
                        <Label text="Excellent" style="-fx-text-fill: #10b981;" />
                    </VBox>
                </HBox>

                <Separator />

                <VBox spacing="8">
                    <HBox spacing="5">
                        <Label text="★★★★½" style="-fx-text-fill: #f59e0b; -fx-font-size: 20;" />
                        <Label text="Superbe chambre, très propre" style="-fx-text-fill: #334155;" />
                    </HBox>
                    <HBox spacing="5">
                        <Label text="★★★★★" style="-fx-text-fill: #f59e0b; -fx-font-size: 20;" />
                        <Label text="Vue magnifique !" style="-fx-text-fill: #334155;" />
                    </HBox>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>